# ==============================================================================
# File: synthesis/de10_lite.qsf
# Target Board: Terasic DE10-Lite
# Target Device: Intel MAX 10 (10M50DAF484C7G)
# Top-Level Entity: de10_lite_top
# ==============================================================================

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY de10_lite_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.1 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation

# ------------------------------------------------------------------------------
# Source RTL Files
# ------------------------------------------------------------------------------
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/core/riscv_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/accelerator/accelerator_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/core/alu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/core/branch_comp.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/core/control_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/core/hazard_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/core/imm_gen.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/core/load_store_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/core/register_file.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/core/riscv_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/soc_interconnect.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/soc_sram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/accelerator/mac.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/accelerator/pe.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/accelerator/accumulator.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/accelerator/relu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/accelerator/controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/accelerator/systolic_array.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/accelerator/accelerator.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/soc_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/de10_lite_top.sv
set_global_assignment -name SDC_FILE de10_lite.sdc

# ------------------------------------------------------------------------------
# Pin & I/O Standard Assignments for Terasic DE10-Lite
# ------------------------------------------------------------------------------
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to MAX10_CLK1_50
set_location_assignment PIN_P11 -to MAX10_CLK1_50

set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to KEY[1]
set_location_assignment PIN_B8 -to KEY[0]
set_location_assignment PIN_A7 -to KEY[1]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[2]
